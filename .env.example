# ==============================================================================
# Thinkloop Backend Environment Configuration Template
# Copy this file to backend/.env for local development. Never commit real secrets.
# ==============================================================================

# Database Connection (PostgreSQL 16 with pgvector extension)
# Async SQLAlchemy requires the asyncpg driver scheme: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thinkloop

# Redis Connection (Async redis-py client for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Authentication (Pluggable JWT verification via JWKS - Clerk/Supabase compatible)
# AUTH_JWKS_URL: Public JSON Web Key Set endpoint providing RS256 public keys
AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# AUTH_ISSUER: Expected JWT 'iss' claim (e.g., https://clerk.example.com or https://<ref>.supabase.co/auth/v1)
AUTH_ISSUER=https://auth.example.com

# AUTH_AUDIENCE: Expected JWT 'aud' claim for Thinkloop backend API
AUTH_AUDIENCE=thinkloop-api

# Optional Configuration Overrides (defaults shown below)
# Application environment: development | staging | production | test
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# JWKS cache time-to-live in seconds
JWKS_CACHE_TTL_SECONDS=3600

# Rate limiting defaults
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional Gemini API key for future AI services (Part 2/3)
GEMINI_API_KEY=your_gemini_api_key_here

