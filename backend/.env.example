# ==============================================================================
# Thinkloop Backend Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Database Connection (Neon PostgreSQL with connection pooling & pgvector)
# Supports direct or pooled Neon connection strings (automatically converted to asyncpg):
# e.g. postgresql+asyncpg://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
# Or standard local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/thinkloop
DATABASE_URL=postgresql+asyncpg://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Connection (Async redis-py client for rate limiting and caching)
# Local Docker instance: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Authentication (Pluggable JWT verification via JWKS - Neon Auth / Clerk / Supabase)
# AUTH_JWKS_URL: Public JSON Web Key Set endpoint (supports EdDSA/Ed25519, RS256, ES256)
# Neon Auth: https://<project-id>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# AUTH_ISSUER: Expected JWT 'iss' claim (e.g. https://<project-id>.neonauth.<region>.aws.neon.tech/neondb/auth)
AUTH_ISSUER=https://auth.example.com

# AUTH_AUDIENCE: Expected JWT 'aud' claim (or origin URL for Neon Auth)
AUTH_AUDIENCE=thinkloop-api

# Content & Vector Embeddings Configuration (Part 2)
# Dimension for vector embeddings (defaults to 1024)
EMBEDDING_DIM=1024

# Optional HTTP Embedder configuration (provider-agnostic; used for live evaluations and production)
EMBEDDING_ENDPOINT_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Optional Gemini API key for future AI services (Part 3 Socratic dialogue)
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime Configuration Overrides (defaults shown below)
# Application environment: development | staging | production | test
ENVIRONMENT=development

# Allow dev token authentication ("dev_<handle>") in non-production environments
AUTH_DEV_MODE=false

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# JWKS cache time-to-live in seconds
JWKS_CACHE_TTL_SECONDS=3600

# Rate limiting defaults (per client IP / user token)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
